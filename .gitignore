# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
venv/
env/
.venv/
# `env/` above would also hide this tracked source directory.
!SimplerEnv/simpler_env/env/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# CRONOS runtime artifacts
CRONOS/cronos_mmap_*/
CRONOS/wandb/
CRONOS/*/wandb/
CRONOS/*.bak
CRONOS/*_ldd.txt
CRONOS/bridge_multi.py.bak
CRONOS/test_checkpoints/
CRONOS/test_alignment.py
CRONOS/test_vla_limits.py

# Logs (all runtime outputs)
*.log
*.out
*.tmp
*_stdout.log
*_stderr.log

# Jupyter
.ipynb_checkpoints/

# Model weights (too large for git)
*.pt
*.pth
*.bin
*.safetensors
*.ckpt

# Datasets / large assets
*.hdf5
*.h5
*.npz

# Videos
*.mp4
*.avi

# Submodule artifacts
openvla/wandb/
SimplerEnv/wandb/
ManiSkill/data/

# Full (internal) branch: doc/, plotting/ and history/ are tracked here.
# The public release branch ignores them. Local-only scratch:
CRONOS/history/_venv/
CRONOS/history/changelog_src/
CRONOS/history/doc_tmp/
reports/
# Scratch renders / tables (doc/tmp), regenerated figures (the pre-V0.99 output
# dir and the current one; see plotting/figures/README.md — figures are never
# committed, only the tools that make them), and local config backups.
CRONOS/doc/tmp/
CRONOS/figures/
CRONOS/plotting/figures/**/*.png
CRONOS/scripts/_bak_*/
